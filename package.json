{
  "name": "mankopi",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:migrate": "pnpm --filter @mankopi/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @mankopi/api prisma:deploy",
    "db:seed": "pnpm --filter @mankopi/api prisma:seed",
    "db:generate": "pnpm --filter @mankopi/api prisma:generate",
    "docker:up": "docker compose -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.override.yml --env-file .env up --build -d",
    "docker:down": "docker compose -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.override.yml --env-file .env down",
    "docker:prod": "docker compose -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.prod.yml --env-file .env.prod up -d"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
