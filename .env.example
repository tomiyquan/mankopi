# Copy to .env for local, .env.prod for VPS (chmod 600). Never bake secrets into images.

NODE_ENV=development
APP_NAME=mankopi
APP_URL=http://localhost:8080
API_URL=http://localhost:8080/api
TENANT_BASE_DOMAIN=localhost

# Generated at first seed. Change before any VPS publish.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

DATABASE_URL=postgresql://mankopi:mankopi@127.0.0.1:55432/mankopi?schema=public
POSTGRES_USER=mankopi
POSTGRES_PASSWORD=mankopi
POSTGRES_DB=mankopi

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mankopi
S3_ACCESS_KEY=mankopi
S3_SECRET_KEY=mankopi-secret
S3_FORCE_PATH_STYLE=true

# Used by Caddy on VPS. Leave empty locally.
DOMAIN=
ACME_EMAIL=

# Seeded platform operator — change after first login
PLATFORM_ADMIN_EMAIL=admin@mankopi.local
PLATFORM_ADMIN_PASSWORD=ChangeMeNow!23

# Demo tenant created by seed (local only)
SEED_DEMO_TENANT=true
